model SessionBooking {
  id             String        @id @default(uuid())
  ownerId        String
  owner          User          @relation(fields: [ownerId], references: [id])
  mentorId       String
  mentor         MentorProfile @relation(fields: [mentorId], references: [id])
  status         BookingStatus @default(PENDING)
  creditsCharged Int           @default(0)
  startTime      DateTime
  endTime        DateTime
  bookingDate    DateTime      @default(now())

  videoSession      VideoSession?
  review            Review?
  creditAllocations BookingCreditAllocation[]
  mentorPayout      MentorPayout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session_booking")
}

model VideoSession {
  id          String         @id @default(uuid())
  bookingId   String         @unique
  booking     SessionBooking @relation(fields: [bookingId], references: [id])
  meetingLink String
  status      SessionStatus  @default(SCHEDULED)
  mentorId    String
  mentor      MentorProfile  @relation(fields: [mentorId], references: [id])
  ownerId     String
  owner       User           @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_session")
}

model Review {
  id        String         @id @default(uuid())
  ownerId   String
  owner     User           @relation(fields: [ownerId], references: [id])
  mentorId  String
  mentor    MentorProfile  @relation(fields: [mentorId], references: [id])
  bookingId String         @unique
  booking   SessionBooking @relation(fields: [bookingId], references: [id])
  rating    Float
  comment   String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("review")
}

model BookingCreditAllocation {
  id              String    @id @default(uuid())
  bookingId       String
  creditLotId     String
  credits         Int
  netRevenueCents Int
  refundedAt      DateTime?
  createdAt       DateTime  @default(now())

  booking   SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  creditLot CreditLot      @relation(fields: [creditLotId], references: [id], onDelete: Restrict)

  @@unique([bookingId, creditLotId])
  @@map("booking_credit_allocation")
}

model MentorPayout {
  id               String   @id @default(uuid())
  bookingId        String   @unique
  mentorId         String
  amountCents      Int
  stripeTransferId String   @unique
  createdAt        DateTime @default(now())

  booking SessionBooking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  mentor  MentorProfile  @relation(fields: [mentorId], references: [id], onDelete: Cascade)

  @@map("mentor_payout")
}
